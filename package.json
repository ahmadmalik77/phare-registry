{
  "name": "phare-registry",
  "version": "2026.06-production.13",
  "private": true,
  "type": "module",
  "description": "Phare — The Lighthouse. Private UHNWI executive intake registry.",
  "scripts": {
    "extract": "node scripts/extract-assets.mjs",
    "build:app": "node scripts/build-app.mjs",
    "build:html": "node scripts/build-html.mjs",
    "build": "npm run build:app && npm run build:html && node scripts/finalize-build.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "audit": "node scripts/audit.mjs",
    "setup": "node scripts/setup-config.mjs",
    "fingerprint": "node scripts/fingerprint.mjs",
    "ci": "npm test && npm run validate"
  },
  "engines": {
    "node": ">=18"
  }
}